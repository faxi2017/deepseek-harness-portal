[Unit]
Description=DeepSeek Harness Portal (Docker)
Requires=docker.service
After=network-online.target docker.service
PartOf=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/deepseek-harness-portal
ExecStart=/usr/bin/node --env-file=/opt/deepseek-harness-portal/.env /opt/deepseek-harness-portal/portal/src/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077

[Install]
WantedBy=multi-user.target
